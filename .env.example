# StyleSaathi Environment Variables Template
# Copy this file to .env.local to configure local development keys.
# NEVER commit .env or .env.local. NEVER put service_role or Google client secrets here.

# Supabase Public Configuration (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=
# Use either VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY:
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
